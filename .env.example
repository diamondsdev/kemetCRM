# High Priest Admin Chamber passcode (defaults to 'pharaoh' if unset)
ADMIN_PASSCODE=pharaoh

# Google Gemini API Key for Sennedjem AI Scribe Oracle
GEMINI_API_KEY=

# Node.js Port (Hostinger sets this dynamically; defaults to 3000)
PORT=3000

# Environment mode ('production' on Hostinger)
NODE_ENV=production